  color: var(--primary-foreground);
}

.category-info {
  min-width: 0;
}

.category-name {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  font-family: var(--font-display);
  font-weight: 600;
  font-size: 0.875rem;
}

@media (min-width: 640px) {
  .category-name {
    font-size: 1rem;
  }
}

.category-label {
  font-size: 0.6875rem;
  color: var(--muted-foreground);
}

@media (min-width: 640px) {
  .category-label {
    font-size: 0.75rem;
  }
}

