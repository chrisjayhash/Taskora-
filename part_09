  20% { transform: rotate(-8deg); }
  40% { transform: rotate(-4deg); }
  50% { transform: rotate(10deg); }
}

.dash-welcome-wave {
  display: inline-block;
  transform-origin: 70% 70%;
  animation: dash-wave 2.4s ease-in-out infinite;
}

/* ── Role CTA ────────────────────────────────────────────────────────────── */

.dash-role-cta {
  display: flex;
  align-items: center;
  gap: 0.9rem;
  padding: 1rem;
  border-radius: 1.1rem;
  flex-wrap: wrap;
}

.dash-role-cta-icon {
  height: 2.75rem;
  width: 2.75rem;
  border-radius: 0.85rem;
  background: linear-gradient(135deg, #2563eb, #7c3aed);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.dash-role-cta-text {
  flex: 1;
  min-width: 10rem;
}

.dash-role-cta-title {
  font-size: 0.85rem;
  font-weight: 700;
  color: var(--foreground);
}

.dash-role-cta-subtitle {
  font-size: 0.75rem;
  color: var(--muted-foreground);
  margin-top: 0.15rem;
}

.dash-role-cta-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  padding: 0.55rem 1rem;
  border-radius: 999px;
  font-size: 0.8rem;
  font-weight: 700;
  white-space: nowrap;
  border: none;
  cursor: pointer;
}

/* ── Section header ──────────────────────────────────────────────────────── */

.dash-section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 0.75rem;
}

.dash-section-title {
  font-size: 0.95rem;
  font-weight: 700;
  color: var(--foreground);
}

.dash-section-link {
  display: flex;
  align-items: center;
  gap: 0.3rem;
  font-size: 0.75rem;
  font-weight: 600;
  color: var(--accent, #60a5fa);
  background: transparent;
  border: none;
  cursor: pointer;
}

/* ── Quick actions ───────────────────────────────────────────────────────── */

.dash-quick-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 0.65rem;
  margin-bottom: 0.85rem;
}

.dash-action-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.7rem 1.1rem;
  border-radius: 999px;
  font-size: 0.8rem;
  font-weight: 700;
  color: #fff;
  text-decoration: none;
  transition: filter 0.15s ease, transform 0.15s ease;
}

.dash-action-btn:hover {
  filter: brightness(1.08);
  transform: translateY(-1px);
}

.dash-action-telegram {
  background: linear-gradient(135deg, #29b6f6, #0288d1);
}

.dash-action-whatsapp {
  background: linear-gradient(135deg, #34d058, #1ea952);
}

.dash-referral-card {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.85rem;
  border-radius: 1rem;
}

.dash-referral-icon {
  height: 2.5rem;
  width: 2.5rem;
  border-radius: 0.75rem;
  background: linear-gradient(135deg, #f59e0b, #ef4444);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.dash-referral-info {
  flex: 1;
  min-width: 0;
}

.dash-referral-title {
  font-size: 0.8rem;
  font-weight: 700;
  color: var(--foreground);
}

.dash-referral-code {
  font-size: 0.72rem;
  color: var(--muted-foreground);
  margin-top: 0.1rem;
}

.dash-referral-code strong {
  color: var(--foreground);
}

.dash-referral-copy {
  height: 2.1rem;
  width: 2.1rem;
  border-radius: 0.6rem;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.1);
  color: var(--foreground);
  cursor: pointer;
  flex-shrink: 0;
}

/* ── Stats grid ──────────────────────────────────────────────────────────── */

.dash-stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 0.75rem;
}

.dash-stat-card {
  padding: 0.9rem;
  border-radius: 1.1rem;
  display: flex;
  flex-direction: column;
  gap: 0.3rem;
  position: relative;
  overflow: hidden;
}

.dash-stat-icon {
  height: 2rem;
  width: 2rem;
  border-radius: 0.6rem;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 0.15rem;
}

.dash-stat-value {
  font-family: var(--font-display);
  font-size: 1.25rem;
  font-weight: 800;
  color: var(--foreground);
}

.dash-stat-label {
  font-size: 0.72rem;
  color: var(--muted-foreground);
}

.dash-stat-helper {
  font-size: 0.65rem;
  font-weight: 600;
}

.dash-stat-blue .dash-stat-icon { background: rgba(37, 99, 235, 0.2); color: #60a5fa; }
.dash-stat-blue .dash-stat-helper { color: #60a5fa; }

.dash-stat-green .dash-stat-icon { background: rgba(16, 185, 129, 0.2); color: #34d399; }
.dash-stat-green .dash-stat-helper { color: #34d399; }

.dash-stat-purple .dash-stat-icon { background: rgba(124, 58, 237, 0.2); color: #a78bfa; }
.dash-stat-purple .dash-stat-helper { color: #a78bfa; }

.dash-stat-pink .dash-stat-icon { background: rgba(236, 72, 153, 0.2); color: #f472b6; }
.dash-stat-pink .dash-stat-helper { color: #f472b6; }

/* ── Categories scroll strip ─────────────────────────────────────────────── */

.dash-categories-scroll {
  display: flex;
  gap: 0.65rem;
  overflow-x: auto;
  padding-bottom: 0.25rem;
}

.dash-no-scrollbar {
  scrollbar-width: none;
  -ms-overflow-style: none;
}

.dash-no-scrollbar::-webkit-scrollbar {
  display: none;
}

.dash-category-chip {
  flex-shrink: 0;
  min-width: 6rem;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.35rem;
  padding: 0.85rem 0.75rem;
  border-radius: 1rem;
  cursor: pointer;
  border: none;
}

.dash-category-chip-icon {
  height: 2.25rem;
  width: 2.25rem;
  border-radius: 0.7rem;
  background: rgba(96, 165, 250, 0.15);
  color: #60a5fa;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dash-category-chip-name {
  font-size: 0.72rem;
  font-weight: 700;
  color: var(--foreground);
}

.dash-category-chip-rate {
  font-size: 0.62rem;
  color: var(--muted-foreground);
}

/* ── Recent activity ─────────────────────────────────────────────────────── */

.dash-activity-list {
  display: flex;
  flex-direction: column;
  gap: 0.55rem;
}

.dash-activity-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
  padding: 0.75rem 0.9rem;
  border-radius: 0.9rem;
}

.dash-activity-title {
  font-size: 0.8rem;
  font-weight: 600;
  color: var(--foreground);
}

.dash-activity-meta {
  font-size: 0.68rem;
  color: var(--muted-foreground);
  margin-top: 0.1rem;
}

.dash-activity-amount {
  font-size: 0.85rem;
  font-weight: 700;
  white-space: nowrap;
}

.dash-activity-amount.positive { color: #34d399; }
.dash-activity-amount.negative { color: #f87171; }

/* ── Bottom nav ──────────────────────────────────────────────────────────── */

.dash-bottom-nav {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 50;
  padding: 0 1rem calc(env(safe-area-inset-bottom, 0px) + 1rem);
}

.dash-bottom-nav-inner {
  max-width: 640px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  padding: 0.6rem 1rem;
  border-radius: 1.5rem;
  background: #0b0f1a;
  box-shadow: 0 -10px 40px rgba(0, 0, 0, 0.4);
  position: relative;
}

.dash-nav-group {
  display: flex;
  align-items: center;
  gap: 0.15rem;
}

.dash-nav-group-left {
  justify-content: flex-end;
  padding-right: 0.25rem;
}

.dash-nav-group-right {
  justify-content: flex-start;
  padding-left: 0.25rem;
}

.dash-nav-group-right .dash-nav-item:last-child {
  margin-left: 0.5rem;
}

.dash-nav-group-right .dash-nav-item:first-child {
  margin-left: 0.5rem;
}

.dash-nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.2rem;
  font-size: 0.62rem;
  font-weight: 600;
  color: #64748b;
  background: transparent;
  border: none;
  padding: 0.4rem 0.6rem;
  border-radius: 0.75rem;
  cursor: pointer;
  transition: color 0.15s ease, background 0.15s ease;
}

.dash-nav-item:hover {
  color: #cbd5e1;
}

.dash-nav-item-active {
  color: #fff;
}

.dash-nav-fab-slot {
  justify-self: center;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dash-nav-fab {
  position: relative;
  top: -1.6rem;
  height: 3.25rem;
  width: 3.25rem;
  border-radius: 999px;
  background: linear-gradient(135deg, #2563eb, #7c3aed);
  border: 4px solid var(--background);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  box-shadow:
    0 6px 18px rgba(37, 99, 235, 0.26),
    0 2px 8px rgba(124, 58, 237, 0.10);
}

.dash-fab-menu {
  position: absolute;
  bottom: calc(100% + 0.75rem);
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  gap: 0.3rem;
  padding: 0.5rem;
  border-radius: 1rem;
  min-width: 11rem;
  box-shadow: 0 12px 40px rgba(0, 0, 0, 0.35);
}

.dash-fab-menu-item {
  display: flex;
  align-items: center;
  gap: 0.55rem;
  padding: 0.6rem 0.7rem;
  border-radius: 0.7rem;
  background: transparent;
  border: none;
  color: var(--foreground);
  font-size: 0.78rem;
  font-weight: 600;
  cursor: pointer;
  white-space: nowrap;
  text-align: left;
}

.dash-fab-menu-item:hover {
  background: rgba(255, 255, 255, 0.08);
}

/* ── Responsive: tighten up on small phones ─────────────────────────────── */

@media (max-width: 380px) {
  .dash-stats-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 0.5rem;
  }
  .dash-hero-title {
    font-size: 1.5rem;
  }
}

/* ── Bottom nav: even content centering + icon spacing ─────────────────── */

.dash-nav-group {
  gap: 0.4rem;
}

.dash-nav-group-left {
  padding-right: 0.6rem;
}

.dash-nav-group-right {
  padding-left: 0.6rem;
}

/* ── Bottom nav: true center fix (fixed FAB column width) ──────────────── */

.dash-bottom-nav-inner {
  grid-template-columns: 1fr 3.5rem 1fr;
}

.dash-nav-group-left {
  padding-right: 0;
}

.dash-nav-group-right {
  padding-left: 0;
}

.dash-nav-fab-slot {
  width: 3.5rem;
}

/* ── Bottom nav: push "More" slightly right for edge breathing room ──────── */

.dash-nav-group-right {
  padding-right: 0.35rem;
}

/* ── Bottom nav: push "More" slightly right for edge breathing room ──────── */

.dash-nav-group-right {
  padding-right: 0.35rem;
}

/* ── Bottom nav: push "More" slightly right for edge breathing room ──────── */

.dash-nav-group-right {
  padding-right: 0.35rem;
}

/* ── Kill mobile tap highlight globally ───────────────────────────────────── */

* {
  -webkit-tap-highlight-color: transparent;
}
/* ============================================
   LIGHT / DARK THEME OVERRIDE
   Default = LIGHT
   ============================================ */

:root {
  --background: #f5f7fa;
  --surface: #ffffff;
  --foreground: #1f2937;
  --muted-foreground: #6b7280;

  --primary: #2563eb;
  --accent: #3b82f6;

  --border: #e5e7eb;

  --card-shadow: 0 2px 8px rgba(0,0,0,0.05);
}

/* DARK MODE OVERRIDE */

html[data-theme='dark'] {
  --background: #0b1120;
  --surface: #172554;
  --foreground: #faf8f6;
  --muted-foreground: #b3bfd6;

  --primary: #2563eb;
  --accent: #60a5fa;

  --border: rgba(255,255,255,0.1);

  --card-shadow: 0 10px 30px rgba(0,0,0,0.4);
}

/* Light mode adjustments */
html:not([data-theme='dark']) .btn-glow {
  box-shadow: none;
}


/* ================================
   DASHBOARD CARD TEXT CONTRAST FIX
   ================================ */

/* Make card titles stronger */
.dash-section-title,
.dash-action-title,
.dash-stat-value,
.dash-role-cta-title,
.dash-welcome-title {
  color: var(--foreground);
  font-weight: 700;
}

/* Improve subtext readability */
.dash-action-subtitle,
.dash-stat-label,
.dash-role-cta-subtitle,
.dash-welcome-subtitle {
  color: #4b5563; /* darker grey for light mode */
}

/* In dark mode keep original softer tone */
html[data-theme='dark'] .dash-action-subtitle,
html[data-theme='dark'] .dash-stat-label,
html[data-theme='dark'] .dash-role-cta-subtitle,
html[data-theme='dark'] .dash-welcome-subtitle {
  color: var(--muted-foreground);
}


/* ============================================
   FIX BLUE CARD TEXT CONTRAST (LIGHT MODE)
   ============================================ */

/* Profile bar */
html:not([data-theme='dark']) .dash-profile-bar {
  background: linear-gradient(135deg, #4c5d85, #5a6ea0);
  color: #ffffff;
}

html:not([data-theme='dark']) .dash-profile-username,
html:not([data-theme='dark']) .dash-profile-currency {
  color: #e5e7eb;
}

/* Role CTA card */
html:not([data-theme='dark']) .dash-role-cta {
  background: linear-gradient(135deg, #4c5d85, #5a6ea0);
  color: #ffffff;
}

html:not([data-theme='dark']) .dash-role-cta-title,
html:not([data-theme='dark']) .dash-role-cta-subtitle {
  color: #f3f4f6;
}

/* Make button readable */
html:not([data-theme='dark']) .dash-role-cta-btn {
  background: #ffffff;
  color: #1f2937;
}

html:not([data-theme='dark']) .dash-role-cta-btn:hover {
  background: #f3f4f6;
}


/* ============================================
   APPLE-LIKE LIGHT MODE (FLAT + SOFT)
   ============================================ */

/* Remove blue gradient backgrounds in light mode */
html:not([data-theme='dark']) .dash-profile-bar,
html:not([data-theme='dark']) .dash-role-cta,
html:not([data-theme='dark']) .dash-action-card,
html:not([data-theme='dark']) .dash-stat-card,
html:not([data-theme='dark']) .dash-category-chip,
html:not([data-theme='dark']) .dash-activity-item,
html:not([data-theme='dark']) .tasks-hero,
html:not([data-theme='dark']) .task-card {
  background: #ffffff !important;
  border: 1px solid #e5e7eb;
  box-shadow: 0 2px 6px rgba(0,0,0,0.05);
}

/* Make dashboard section headings darker */
html:not([data-theme='dark']) .dash-section-title {
  color: #111827;
}

/* Make action card titles strong */
html:not([data-theme='dark']) .dash-action-title {
  color: #111827;
  font-weight: 700;
}

/* Make subtext properly visible */
html:not([data-theme='dark']) .dash-action-subtitle,
html:not([data-theme='dark']) .dash-stat-label,
html:not([data-theme='dark']) .dash-role-cta-subtitle,
html:not([data-theme='dark']) .dash-activity-meta {
  color: #6b7280;
}

/* Stats values stronger */
html:not([data-theme='dark']) .dash-stat-value {
  color: #111827;
}

/* Recent activity amount colors preserved */
html:not([data-theme='dark']) .dash-activity-amount.positive {
  color: #16a34a;
}

html:not([data-theme='dark']) .dash-activity-amount.negative {
  color: #ef4444;
}

/* Tasks page hero flatten */
html:not([data-theme='dark']) .tasks-hero {
  background: #ffffff;
}

/* Search input flatten */
html:not([data-theme='dark']) .tasks-search {
  background: #f9fafb;
  border: 1px solid #e5e7eb;
}

/* Category dropdown flatten */
html:not([data-theme='dark']) .tasks-categories {
  background: #f9fafb;
  border: 1px solid #e5e7eb;
}

/* Remove glass blur effect in light mode */
html:not([data-theme='dark']) .glass,
html:not([data-theme='dark']) .glass-strong {
  backdrop-filter: none;
}

/* Soften accent blues */
html:not([data-theme='dark']) .text-gradient {
  color: #2563eb;
}

/* Reduce radius slightly (modern look) */
html:not([data-theme='dark']) .dash-action-card,
html:not([data-theme='dark']) .dash-stat-card,
html:not([data-theme='dark']) .dash-activity-item,
html:not([data-theme='dark']) .task-card {
  border-radius: 10px;
}


/* ============================================
   PROFILE BAR FLAT LIGHT MODE
   ============================================ */

html:not([data-theme='dark']) .dash-profile-bar {
  background: #ffffff;
  border: 1px solid #e5e7eb;
  box-shadow: 0 2px 6px rgba(0,0,0,0.05);
  color: #111827;
}

html:not([data-theme='dark']) .dash-profile-username {
  color: #111827;
}

html:not([data-theme='dark']) .dash-profile-currency {
  color: #6b7280;
}


/* ============================================
   TASKS PAGE FLAT LIGHT MODE
   ============================================ */

html:not([data-theme='dark']) .tasks-mini-stat {
  background: #f3f4f6;
  border: 1px solid #e5e7eb;
}

html:not([data-theme='dark']) .tasks-mini-stat-top {
  color: #111827;
}

html:not([data-theme='dark']) .tasks-mini-stat-bottom {
  color: #6b7280;
}

html:not([data-theme='dark']) .task-banner-chip {
  background: rgba(0,0,0,0.05);
  color: #111827;
}


/* ============================================
   HEADER — LIGHT MODE SOFT STYLE
   ============================================ */

html:not([data-theme='dark']) .dash-header-inner {
  background: #4f5d7a; /* soft muted blue */
  border: none;
  box-shadow: 0 2px 6px rgba(0,0,0,0.08);
}

html:not([data-theme='dark']) .dash-logo-text {
  color: #ffffff;
  font-weight: 700;
}

html:not([data-theme='dark']) .dash-menu-trigger {
  color: #ffffff;
}


/* ============================================
   POPUP MENU — LIGHT MODE CLEAN
   ============================================ */

html:not([data-theme='dark']) .dash-menu-dropdown {
  background: #ffffff;
  border-radius: 14px;
  border: 1px solid #e5e7eb;
  box-shadow: 0 8px 20px rgba(0,0,0,0.08);
  padding: 0.75rem;
}

html:not([data-theme='dark']) .dash-menu-item {
  color: #111827;
  font-weight: 500;
  border-radius: 10px;
}

html:not([data-theme='dark']) .dash-menu-item:hover {
  background: #f3f4f6;
}

html:not([data-theme='dark']) .dash-menu-item-danger {
  color: #ef4444;
}

html:not([data-theme='dark']) .dash-menu-sep {
  background: #e5e7eb;
}


/* ============================================
   BOTTOM NAV — LIGHT MODE REFINEMENT
   ============================================ */

/* Slim bottom nav */
html:not([data-theme='dark']) .dash-bottom-nav-inner {
  background: #ffffff;
  border-radius: 18px;
  box-shadow: 0 -4px 16px rgba(0,0,0,0.08);
}

/* Slim nav items */
html:not([data-theme='dark']) .dash-nav-item {
  color: #6b7280;
}

html:not([data-theme='dark']) .dash-nav-item-active {
  color: #111827;
}

/* FAB style */
html:not([data-theme='dark']) .dash-nav-fab {
  background: linear-gradient(135deg, #6366f1, #8b5cf6);
  box-shadow: 0 6px 18px rgba(99,102,241,0.4);
}

/* Floating popup ABOVE FAB */
html:not([data-theme='dark']) .dash-fab-menu {
  bottom: calc(100% + 1.2rem);
  left: 50%;
  transform: translateX(-50%);
  background: transparent;
  padding: 0;
  box-shadow: none;
}

/* Individual floating pill buttons */
html:not([data-theme='dark']) .dash-fab-menu-item {
  background: #ffffff;
  border: 1px solid #e5e7eb;
  border-radius: 14px;
  padding: 0.65rem 1rem;
  margin-bottom: 0.6rem;
  box-shadow: 0 4px 14px rgba(0,0,0,0.08);
  font-weight: 600;
  color: #111827;
  justify-content: center;
}

html:not([data-theme='dark']) .dash-fab-menu-item:hover {
  background: #f3f4f6;
}


/* ============================================
   LIGHT MODE ICON BACKGROUND SOFTENING
   ============================================ */

/* Dashboard icons */
html:not([data-theme='dark']) .dash-action-icon,
html:not([data-theme='dark']) .dash-stat-icon,
html:not([data-theme='dark']) .dash-category-chip-icon,
html:not([data-theme='dark']) .dash-hero-icon {
  background: #eef2ff; /* soft lavender */
  color: #4f46e5;
  box-shadow: none;
}

/* Tasks page icon */
html:not([data-theme='dark']) .tasks-hero-icon {
  background: #eef2ff;
  color: #4f46e5;
}

/* Remove heavy glow in light */
html:not([data-theme='dark']) .dash-action-blue .dash-action-icon,
html:not([data-theme='dark']) .dash-action-green .dash-action-icon,
html:not([data-theme='dark']) .dash-action-purple .dash-action-icon,
html:not([data-theme='dark']) .dash-action-pink .dash-action-icon {
  background: #eef2ff;
  color: #4f46e5;
}


/* ============================================
   LANDING PAGE — LIGHT MODE SUPPORT
   ============================================ */

/* ── Header ─────────────────────────────────────────────────────────── */

html:not([data-theme='dark']) .header-nav {
  background: #ffffff;
  border: 1px solid #e5e7eb;
}

html:not([data-theme='dark']) .header-signin {
  color: #4b5563;
