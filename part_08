  color: var(--foreground);
  cursor: pointer;
  transition: background 0.15s ease;
}

.dash-icon-btn:hover {
  background: rgba(255, 255, 255, 0.12);
}

.dash-icon-badge {
  position: absolute;
  top: -0.2rem;
  right: -0.2rem;
  height: 1.05rem;
  min-width: 1.05rem;
  padding: 0 0.25rem;
  border-radius: 999px;
  background: #ef4444;
  color: #fff;
  font-size: 0.6rem;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2px solid var(--background);
}

/* ── Announcement marquee ────────────────────────────────────────────────── */

.dash-announce {
  overflow: hidden;
  border-radius: 0.85rem;
  background: #0b0f1a;
  border: 1px solid rgba(255, 255, 255, 0.06);
}

.dash-announce-track {
  display: flex;
  width: max-content;
}

.dash-announce-item {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.65rem 1.25rem;
  font-size: 0.78rem;
  font-weight: 500;
  color: #f1f5f9;
  white-space: nowrap;
}

.dash-announce-icon {
  color: #60a5fa;
  flex-shrink: 0;
}

/* ── Welcome ─────────────────────────────────────────────────────────────── */

.dash-welcome-title {
  font-size: 1.15rem;
  font-weight: 700;
  color: var(--foreground);
  display: flex;
  align-items: center;
  gap: 0.4rem;
  flex-wrap: wrap;
}

.dash-welcome-subtitle {
  margin-top: 0.25rem;
  font-size: 0.8rem;
  color: var(--muted-foreground);
}

@keyframes dash-wave {
  0%, 60%, 100% { transform: rotate(0deg); }
  10%, 30% { transform: rotate(14deg); }
