  padding: 0.9rem 1rem;
  border-radius: 1rem;
  border: 1px solid rgba(96, 165, 250, 0.4);
  background: rgba(96, 165, 250, 0.14);
  backdrop-filter: blur(14px) saturate(160%);
  color: var(--foreground);
  font-size: 0.88rem;
  font-weight: 900;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
