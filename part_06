  animation: tdm-spin 0.75s linear infinite;
}

@keyframes tdm-spin {
  to { transform: rotate(360deg); }
}

.tdm-ripple {
  position: absolute;
  border-radius: 999px;
  background: rgba(255,255,255,0.35);
  transform: scale(0);
  pointer-events: none;
  animation: tdm-ripple-anim 600ms ease-out;
}

@keyframes tdm-ripple-anim {
  to { transform: scale(2.8); opacity: 0; }
}

/* ================= WARNING / STATUS BOXES ================= */

.tdm-warning-box {
  display: flex;
  gap: 0.8rem;
  background: #fff7ed;
  border: 1px solid #fde68a;
  border-radius: 14px;
  padding: 1rem;
  margin-bottom: 1.25rem;
  color: #78350f;
}

.tdm-warning-box strong {
  color: #92400e;
}

.tdm-warning-box p {
  margin: 0.3rem 0 0;
  font-size: 0.85rem;
  color: #78350f;
}

html[data-theme='dark'] .tdm-warning-box {
  background: #3b2f05;
  border: 1px solid #92400e;
  color: #facc15;
}

html[data-theme='dark'] .tdm-warning-box strong {
  color: #fde047;
}

html[data-theme='dark'] .tdm-warning-box p {
  color: #fef08a;
}

.tdm-error-box {
  padding: 0.75rem 0.9rem;
  border-radius: 12px;
  border: 1px solid rgba(239,68,68,0.4);
  background: rgba(239,68,68,0.1);
  color: #ef4444;
  font-size: 0.82rem;
  margin-bottom: 1rem;
}

.tdm-success-box {
  display: flex;
  align-items: center;
  gap: 0.55rem;
  padding: 1rem;
  border-radius: 14px;
  border: 1px solid rgba(34,197,94,0.4);
  background: rgba(34,197,94,0.1);
  color: #16a34a;
  font-weight: 700;
  margin-bottom: 1.25rem;
}

html[data-theme='dark'] .tdm-success-box {
  color: #4ade80;
}

.tdm-unavailable-box {
  padding: 1rem;
  border-radius: 14px;
  border: 1px solid var(--border);
  background: var(--surface);
  color: var(--muted-foreground);
  text-align: center;
  margin-bottom: 1.25rem;
}

/* ================= OPEN LINK BUTTON ================= */

.tdm-open-btn {
  width: 100%;
  padding: 1rem;
  border-radius: 14px;
  border: none;
  background: linear-gradient(135deg, #6366f1, #8b5cf6);
  color: white;
  font-size: 1rem;
  font-weight: 600;
  box-shadow: 0 8px 18px rgba(99,102,241,0.35);
  transition: transform 0.2s ease;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  margin-bottom: 1.25rem;
  cursor: pointer;
}

.tdm-open-btn:hover {
  transform: translateY(-2px);
}

/* ================= PROGRESS ================= */

.tdm-progress {
  height: 8px;
  background: rgba(0,0,0,0.08);
  border-radius: 999px;
  overflow: hidden;
  margin-bottom: 0.5rem;
}

html[data-theme='dark'] .tdm-progress {
  background: rgba(255,255,255,0.12);
}

.tdm-progress-bar {
  height: 100%;
  background: linear-gradient(90deg, #22c55e, #16a34a);
  border-radius: 999px;
  transition: width 0.4s ease;
}

.tdm-progress-meta {
  display: flex;
  justify-content: space-between;
  font-size: 0.8rem;
  margin-bottom: 1rem;
  color: var(--muted-foreground);
}

/* ================= DETAILS GRID ================= */

.tdm-details-grid {
  display: grid;
  gap: 0.7rem;
}

.tdm-details-grid div {
  display: flex;
  justify-content: space-between;
  font-size: 0.88rem;
  border-bottom: 1px solid var(--border);
  padding-bottom: 0.55rem;
  color: var(--muted-foreground);
}

.tdm-details-grid div:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.tdm-details-grid strong {
  color: var(--foreground);
  font-weight: 700;
}

/* ================= SKELETON ================= */

.tdm-skel-block {
  border-radius: 8px;
  background-image: linear-gradient(
    90deg,
    rgba(0,0,0,0.06) 0%,
    rgba(0,0,0,0.13) 50%,
    rgba(0,0,0,0.06) 100%
  );
  background-size: 200% 100%;
  animation: tdm-shimmer 1.4s linear infinite;
}

html[data-theme='dark'] .tdm-skel-block {
  background-image: linear-gradient(
    90deg,
    rgba(255,255,255,0.06) 0%,
    rgba(255,255,255,0.16) 50%,
    rgba(255,255,255,0.06) 100%
  );
}

.tdm-skel-hero {
  position: relative;
}

.tdm-skel-hero::after {
  content: '';
  position: absolute;
  inset: 0;
  background-image: linear-gradient(
    90deg,
    transparent 0%,
    rgba(255,255,255,0.08) 50%,
    transparent 100%
  );
  background-size: 200% 100%;
  animation: tdm-shimmer 1.6s linear infinite;
  pointer-events: none;
}

@keyframes tdm-shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

